---
/**
 * Sol y Luna sobre el puerto: ortos y ocasos con su acimut, crepúsculos y fase con iluminación.
 *
 * Es información **contextual**: no se lee para decidir a qué hora ir, se lee para saber si habrá
 * luz cuando se llegue. De ahí que vaya debajo de la tabla y de la curva, en cuerpo normal, y que
 * los crepúsculos se den los tres (civil, náutico y astronómico) sin explicar cuál es cuál — quien
 * los busca sabe lo que son y quien no, no los necesita.
 *
 * El acimut se publica en grados y en rumbo de la rosa («71° (ENE)»): el grado es el dato y el
 * rumbo es lo que se usa al mirar el horizonte.
 */
import type { GetAstroResult } from "@mareia/usecases";

import { efemeridesDeHorizonte, nombreDeFase, parDeCrepusculo } from "../cielo.ts";
import { hora, kilometros, numero, porcentaje } from "../formato.ts";

interface Props {
  astro: GetAstroResult;
}

const { astro } = Astro.props;
const zona = astro.timezone;

const sol = astro.sun;
const luna = astro.moon;

// El orto y el ocaso salen juntos: cuando a uno le falta el evento, la razón está en el otro.
const horizonteDelSol = efemeridesDeHorizonte(sol, zona, "sun");
const horizonteDeLaLuna = efemeridesDeHorizonte(luna, zona, "moon");

const filasDelSol = [
  { titulo: "Amanece", efemeride: horizonteDelSol.sale },
  { titulo: "Anochece", efemeride: horizonteDelSol.sePone },
  {
    titulo: "Mediodía solar",
    efemeride: {
      hora: hora(sol.transit.timeUtcMs, zona),
      detalle: `${numero(sol.transit.altitude_deg, 1)}° de altura`,
      ausencia: undefined,
    },
  },
  { titulo: "Crepúsculo civil", efemeride: parDeCrepusculo(sol.twilight.civil, zona) },
  { titulo: "Crepúsculo náutico", efemeride: parDeCrepusculo(sol.twilight.nautical, zona) },
  { titulo: "Crepúsculo astronómico", efemeride: parDeCrepusculo(sol.twilight.astronomical, zona) },
];

const filasDeLaLuna = [
  { titulo: "Sale", efemeride: horizonteDeLaLuna.sale },
  { titulo: "Se pone", efemeride: horizonteDeLaLuna.sePone },
  {
    titulo: "Paso superior",
    efemeride: {
      hora: hora(luna.upperTransit.timeUtcMs, zona),
      detalle: `${numero(luna.upperTransit.altitude_deg, 1)}° de altura`,
      ausencia: undefined,
    },
  },
];

const fase = nombreDeFase(luna.illumination.name);
---

<div class="astros">
  <section class="astro" id="sol" aria-labelledby="titulo-sol">
    <div class="astro__cabecera">
      <svg class="astro__icono astro__icono--sol" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4.5"></circle>
        <line x1="12" y1="2.5" x2="12" y2="5"></line>
        <line x1="12" y1="19" x2="12" y2="21.5"></line>
        <line x1="2.5" y1="12" x2="5" y2="12"></line>
        <line x1="19" y1="12" x2="21.5" y2="12"></line>
        <line x1="5.3" y1="5.3" x2="7" y2="7"></line>
        <line x1="17" y1="17" x2="18.7" y2="18.7"></line>
        <line x1="5.3" y1="18.7" x2="7" y2="17"></line>
        <line x1="17" y1="7" x2="18.7" y2="5.3"></line>
      </svg>
      <h2 class="etiqueta" id="titulo-sol">Sol</h2>
    </div>
    <div class="datos">
      {
        filasDelSol.map((fila) => (
          <p class="datos__fila">
            <span>{fila.titulo}</span>
            <span class="datos__valor">
              {fila.efemeride.hora ?? fila.efemeride.ausencia}
              {fila.efemeride.detalle && <span class="datos__nota"> {fila.efemeride.detalle}</span>}
            </span>
          </p>
        ))
      }
    </div>
  </section>

  <section class="astro" id="luna" aria-labelledby="titulo-luna">
    <div class="astro__cabecera">
      <svg class="astro__icono astro__icono--luna" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M19.5 13.5 A 8 8 0 1 1 10.5 4.5 A 6.5 6.5 0 0 0 19.5 13.5 Z"></path>
      </svg>
      <h2 class="etiqueta" id="titulo-luna">Luna</h2>
    </div>
    <div class="datos">
      <p class="datos__fila">
        <span>Fase</span>
        <span class="datos__valor">
          {fase}
          {/* Un decimal: redondeado al entero, un 99,7 % sale como «100 % iluminada» junto a una
              fase «menguante gibosa», y la página se contradice a sí misma sin estar equivocada. */}
          <span class="datos__nota">
            {porcentaje(luna.illumination.illuminatedFraction, 1)} iluminada</span
          >
        </span>
      </p>
      {
        filasDeLaLuna.map((fila) => (
          <p class="datos__fila">
            <span>{fila.titulo}</span>
            <span class="datos__valor">
              {fila.efemeride.hora ?? fila.efemeride.ausencia}
              {fila.efemeride.detalle && <span class="datos__nota"> {fila.efemeride.detalle}</span>}
            </span>
          </p>
        ))
      }
      <p class="datos__fila">
        <span>Distancia</span>
        <span class="datos__valor">{kilometros(luna.distance.distance_km)}</span>
      </p>
    </div>
  </section>
</div>
