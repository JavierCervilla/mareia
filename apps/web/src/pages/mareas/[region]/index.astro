---
/**
 * Índice de una región: `/mareas/<región>/`.
 *
 * Enseña las provincias **y sus puertos** en el mismo golpe de vista: en una región con dos o tres
 * provincias, obligar a un toque más para ver cuatro puertos sería burocracia de navegación.
 *
 * Cada puerto dice si su marea está **medida** ahí o es una **estimación**, con la misma palabra y
 * el mismo componente que la portada. T-14B dio la señal a la portada y la dejó fuera de aquí, y el
 * pase adversario midió lo que eso costaba: 153 de 153 puertos mudos en estas doce páginas, que son
 * las de la ruta que la propia portada llama canónica («Ver todas las regiones»). Una señal que
 * solo está en una de las tres listas de puertos del portal no quita la omisión en el punto de
 * decisión: la mueve un clic más abajo.
 *
 * Lo que **no** baja aquí es el filtro por calidad: es un mando para descartar en una lista que no
 * cabe de un vistazo (153 en la portada), y la región mediana tiene 17 puertos. El razonamiento
 * completo, con las cifras, en `apps/web/design-brief.md` §7 quater.
 */
import Indice from "../../../componentes/Indice.astro";
import Migas from "../../../componentes/Migas.astro";
import { cargarCatalogo, puertosDeRegion } from "../../../datos/catalogo.ts";
import type { Region } from "../../../datos/catalogo.ts";
import AlmanaqueLayout from "../../../layouts/AlmanaqueLayout.astro";
import { migasDeRegion } from "../../../migas.ts";
import { rutaProvincia, rutaPuerto, rutaRegion, urlAbsoluta } from "../../../rutas.ts";
import { grafo, migasEstructuradas } from "../../../seo.ts";

export async function getStaticPaths() {
  const regiones = await cargarCatalogo();
  return regiones.map((region) => ({ params: { region: region.slug }, props: { region } }));
}

interface Props {
  region: Region;
}

const { region } = Astro.props;
const puertos = puertosDeRegion(region);

const titulo = `Mareas en ${region.nombre} · Mareia`;
const descripcion =
  `Puertos de ${region.nombre} con tabla de mareas, coeficiente y efemérides de sol y luna: ` +
  `${puertos.map((puerto) => puerto.name).join(", ")}.`;

const migas = migasDeRegion({ slug: region.slug, name: region.nombre });
---

<AlmanaqueLayout
  titulo={titulo}
  descripcion={descripcion}
  canonica={urlAbsoluta(rutaRegion(region.slug), Astro.site)}
  jsonLd={grafo([migasEstructuradas(migas, Astro.site)])}
>
  <Migas slot="migas" migas={migas} />

  <header class="portada">
    <h1 class="portada__titulo">Mareas en {region.nombre}</h1>
    <p class="portada__entradilla">
      {puertos.length === 1 ? "1 puerto" : `${puertos.length} puertos`} en {
        region.provincias.length === 1 ? "1 provincia" : `${region.provincias.length} provincias`
      }.
    </p>
  </header>

  {
    region.provincias.map((provincia) => (
      <section class="grupo" aria-labelledby={`provincia-${provincia.slug}`}>
        <h2 class="etiqueta" id={`provincia-${provincia.slug}`}>
          <a href={rutaProvincia(region.slug, provincia.slug)}>{provincia.nombre}</a>
        </h2>
        <Indice
          titulo={`Puertos de ${provincia.nombre}`}
          entradas={provincia.puertos.map((puerto) => ({
            nombre: puerto.name,
            ruta: rutaPuerto(puerto),
            estimada: puerto.quality.estimated,
          }))}
        />
      </section>
    ))
  }
</AlmanaqueLayout>
