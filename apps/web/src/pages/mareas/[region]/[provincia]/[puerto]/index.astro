---
/**
 * Página de puerto: `/mareas/<región>/<provincia>/<puerto>/`.
 *
 * El corazón del portal. Se genera **en build**, una por puerto del catálogo, llamando a los mismos
 * casos de uso que sirve el API (`getTides`, `getAstro`, `getPort`): la web no tiene su propia
 * versión de la marea. Cero JavaScript de cliente: todo lo que se ve aquí es HTML y CSS.
 *
 * El orden de los bloques es el de la jerarquía del brief (crítico → contextual → consultable):
 * los avisos del puerto (marea de centímetros, estación sin observación con la que validar), tabla
 * del día, curva, sol y luna, tabla del mes y, al final, la calidad del dato y sus fuentes.
 */
import AvisoEstimado from "../../../../../componentes/AvisoEstimado.astro";
import AvisoMicromareal from "../../../../../componentes/AvisoMicromareal.astro";
import Coeficiente from "../../../../../componentes/Coeficiente.astro";
import GraficoMarea from "../../../../../componentes/GraficoMarea.astro";
import Migas from "../../../../../componentes/Migas.astro";
import PieAtribuciones from "../../../../../componentes/PieAtribuciones.astro";
import SeccionesDeModulos from "../../../../../componentes/SeccionesDeModulos.astro";
import SolYLuna from "../../../../../componentes/SolYLuna.astro";
import TablaDia from "../../../../../componentes/TablaDia.astro";
import TablaMes from "../../../../../componentes/TablaMes.astro";
import Transparencia from "../../../../../componentes/Transparencia.astro";
import { cargarPuertos } from "../../../../../datos/catalogo.ts";
import { FECHA_DE_BUILD } from "../../../../../datos/fecha-build.ts";
import { cargarDatosDePuerto } from "../../../../../datos/pagina-puerto.ts";
import { coordenadas, fechaLarga, mesYAno } from "../../../../../formato.ts";
import { trazarCurvaMarea } from "../../../../../grafico-marea.ts";
import AlmanaqueLayout from "../../../../../layouts/AlmanaqueLayout.astro";
import { migasDePuerto } from "../../../../../migas.ts";
import { sectionsForPort } from "../../../../../modules.config.ts";
import { ventanasDeSecciones } from "../../../../../modulos/ventanas.ts";
import { rutaPuerto, urlAbsoluta } from "../../../../../rutas.ts";
import { grafo, lugarEstructurado, migasEstructuradas } from "../../../../../seo.ts";

export async function getStaticPaths() {
  const puertos = await cargarPuertos();
  return puertos.map((puerto) => ({
    params: {
      region: puerto.region.slug,
      provincia: puerto.province.slug,
      puerto: puerto.slug,
    },
    props: { slug: puerto.slug },
  }));
}

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const datos = await cargarDatosDePuerto(slug, FECHA_DE_BUILD);
const { port, station, dia, mes, astro } = datos;

/**
 * Lo que la página le cuenta a las secciones de los módulos, y lo único: qué puerto, qué día y en
 * qué zona se escriben las horas. Cada sección le pide sus datos a los casos de uso.
 */
const contextoDeModulos = {
  slug: port.slug,
  nombre: port.name,
  fechaIso: datos.fechaIso,
  timezone: port.timezone,
};
const seccionesDeModulos = sectionsForPort({ slug: port.slug });

/**
 * Las bandas del gráfico se piden ANTES de trazar la curva, porque son geometría del mismo lienzo.
 * Salen de las secciones que la página va a renderizar: sin módulos activos la lista viene vacía y
 * el gráfico es exactamente el de T-09.
 */
const ventanas = await ventanasDeSecciones(seccionesDeModulos, contextoDeModulos);

const curva = trazarCurvaMarea({
  muestras: dia.muestras.map((muestra) => ({
    timeUtcMs: muestra.timeUtcMs,
    height_m: muestra.height_m,
  })),
  extremos: dia.eventos.map((evento) => ({
    timeUtcMs: evento.timeUtcMs,
    height_m: evento.height_m,
    kind: evento.kind,
  })),
  inicioUtcMs: dia.inicioUtcMs,
  finUtcMs: dia.finUtcMs,
  ventanas,
});

const titulo = `Mareas en ${port.name} · ${fechaLarga(datos.fechaIso)} · Mareia`;
const descripcion =
  `Pleamares y bajamares de hoy en ${port.name} (${port.province.name}): tabla del día y del mes, ` +
  `curva de 24 horas, coeficiente de marea y horas de sol y luna. Cálculo propio con fuentes ` +
  `abiertas, sin publicidad.`;

const migas = migasDePuerto(port.region, port.province, port.name);
const ruta = rutaPuerto(port);
const canonica = urlAbsoluta(ruta, Astro.site);
const jsonLd = grafo([
  lugarEstructurado(port, ruta, Astro.site),
  migasEstructuradas(migas, Astro.site),
]);
---

<AlmanaqueLayout
  titulo={titulo}
  descripcion={descripcion}
  canonica={canonica}
  jsonLd={jsonLd}
>
  <Migas slot="migas" migas={migas} />

  <header class="identidad">
    <div>
      <h1 class="identidad__nombre">{port.name}</h1>
      <p class="identidad__meta">
        {port.province.name} · {port.region.name} · {coordenadas(port.lat, port.lon)} · horas en
        hora local ({port.timezone})
      </p>
    </div>
    <section id="coeficiente" aria-label="Coeficiente de marea del día">
      <Coeficiente coeficiente={datos.coeficiente} />
    </section>
  </header>

  {/* Los dos avisos son independientes: uno habla de la marea del puerto (su carrera real) y el
      otro de nuestra medida (si la predicción se ha comprobado aquí). Confundirlos fue el hallazgo
      A-8 del pase adversario. Desde T-13 el segundo cubre también al puerto que hereda las
      constantes del mareógrafo de al lado, que es la mayoría del catálogo. */}
  {
    datos.micromareal && (
      <AvisoMicromareal puerto={port.name} carreraMensualM={datos.carreraMensualM} />
    )
  }
  {
    datos.estimado && (
      <AvisoEstimado
        puerto={port.name}
        carreraMensualM={datos.carreraMensualM}
        motivo={datos.motivoEstimado}
        errorMedido={datos.errorMedido}
      />
    )
  }

  <div class="cuerpo">
    <section class="bloque cuerpo__mareas" id="tabla-de-mareas" aria-labelledby="titulo-hoy">
      <h2 class="etiqueta" id="titulo-hoy">Mareas de hoy · {fechaLarga(datos.fechaIso)}</h2>
      <TablaDia eventos={dia.eventos} timezone={port.timezone} puerto={port.name} />
    </section>

    <section class="bloque cuerpo__grafico" id="curva-de-marea" aria-labelledby="titulo-curva">
      <h2 class="etiqueta" id="titulo-curva">Altura de marea · 24 horas</h2>
      <GraficoMarea curva={curva} timezone={port.timezone} />
    </section>

    <div class="cuerpo__astros" id="sol-y-luna">
      <SolYLuna astro={astro} />
    </div>
  </div>

  <SeccionesDeModulos secciones={seccionesDeModulos} contexto={contextoDeModulos} />

  <section class="bloque" id="tabla-mensual" aria-labelledby="titulo-mes">
    <h2 class="bloque__titulo" id="titulo-mes">Mareas de {mesYAno(datos.fechaIso)}</h2>
    <TablaMes
      dias={mes.dias}
      timezone={port.timezone}
      fechaIso={datos.fechaIso}
      puerto={port.name}
    />
  </section>

  <Transparencia station={station} />
  <PieAtribuciones atribuciones={station.attributions} />
</AlmanaqueLayout>
