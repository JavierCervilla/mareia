---
/**
 * Layout base del almanaque: `<head>`, tipografía, cabecera de marca, el banner de aviso y el
 * armazón que comparten todas las páginas del portal.
 *
 * No carga NADA de JavaScript de cliente: las páginas del core son HTML estático (requisito de
 * T-09). El único `<script>` que puede aparecer es el `application/ld+json` del SEO, que es datos
 * declarativos y no código: no se ejecuta, no hidrata y no pesa en el hilo principal.
 *
 * El tema claro/noche/impresión lo resuelve el CSS de `@mareia/ui/tokens.css` con la preferencia
 * del sistema, sin script de detección.
 */
import "@mareia/ui/tokens.css";
import "../estilos/almanaque.css";
import "../estilos/indices.css";
import "../estilos/meteo.css";
import "../estilos/pagina-puerto.css";
// La hoja de la sección del módulo `fishing` (T-10). Se importa aquí y no desde su componente
// porque Astro no la mete en el bundle cuando el componente llega por el mapa de renderizadores
// (`secciones.ts`): la sección se publicaba sin estilos y con el build en verde. Un test del
// `dist/` comprueba que las reglas siguen publicándose.
import "../estilos/actividad-solunar.css";
// La hoja de la PWA (T-12): la sección «sin cobertura» y la calculadora de otro día. Se importa
// aquí por el mismo motivo que la de arriba —una sola hoja compartida y cacheada por todas las
// páginas— aunque sus dos secciones solo salgan en la página de puerto.
import "../estilos/offline.css";

import { FECHA_DE_BUILD } from "../datos/fecha-build.ts";
import { escaparMarcado } from "../escapar-marcado.ts";
import { fechaLarga } from "../formato.ts";
import { serializarJsonLd } from "../json-ld.ts";
import { COLOR_MARCA } from "../pwa/marca.ts";
import { RUTA_MANIFEST } from "../pwa/protocolo.ts";

interface Props {
  titulo: string;
  descripcion: string;
  /** URL canónica absoluta de la página; `undefined` si no hay dominio configurado. */
  canonica?: string | undefined;
  /** Grafo JSON-LD de la página. Se serializa escapado (ver `json-ld.ts`). */
  jsonLd?: unknown;
}

const { titulo, descripcion, canonica, jsonLd } = Astro.props;

// Instrument Serif (display) + Newsreader (texto), las dos familias del design system.
const FUENTES =
  "https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1" +
  "&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400" +
  "&display=swap";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    {/* `escaparMarcado`: Astro no escapa `<`/`>` en un valor de atributo — ver el módulo. */}
    <meta name="description" content={escaparMarcado(descripcion)} />
    {canonica && <link rel="canonical" href={canonica} />}
    {/*
      El manifiesto va en TODAS las páginas y el service worker solo se registra en la de puerto
      (T-12): el manifiesto es una declaración de identidad de nueve líneas de JSON, no cuesta
      JavaScript y no tiene sentido que el sitio se presente con un nombre distinto según por dónde
      se entre. `theme-color` acompaña al manifiesto porque el navegador lo lee del documento antes
      de instalar nada.
    */}
    <link rel="manifest" href={RUTA_MANIFEST} />
    <meta name="theme-color" content={COLOR_MARCA} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={FUENTES} />
    {
      jsonLd && (
        // El JSON-LD es la única vía por la que entra `set:html` en todo el sitio: el contenido de
        // un <script> no admite las expresiones escapadas de Astro (escaparían las comillas del
        // JSON y lo romperían). El dato va serializado por `serializarJsonLd`, que convierte `<`,
        // `>`, `&` y los separadores de línea en secuencias \uXXXX, así que no puede cerrar la
        // etiqueta ni introducir marcado — ver `src/json-ld.ts`.
        // eslint-disable-next-line astro/no-set-html-directive -- justificado arriba
        <script type="application/ld+json" is:inline set:html={serializarJsonLd(jsonLd)} />
      )
    }
  </head>
  <body>
    <main class="pagina">
      <header class="marca">
        <a class="marca__nombre" href="/">Mareia</a>
        <p class="marca__fecha">
          Datos generados el <time datetime={FECHA_DE_BUILD}>{fechaLarga(FECHA_DE_BUILD)}</time>
        </p>
        <div class="filete-doble" aria-hidden="true"><span></span><span></span></div>
      </header>

      <slot name="migas" />

      <p class="aviso-navegacion">
        <strong>No apto para navegación.</strong> Predicción calculada con fuentes abiertas y
        métodos publicados; para navegar, consulte las publicaciones oficiales de su autoridad
        hidrográfica.
      </p>

      <slot />
    </main>
  </body>
</html>
